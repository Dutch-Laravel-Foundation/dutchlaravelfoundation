APP_NAME="Dutch Laravel Foundation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# composer dev requires environment-assigned APP_URL, APP_PORT, VITE_PORT and INERTIA_SSR_URL.
# Do not start it when the Project workspace already manages the server.
APP_PORT=
VITE_PORT=
INERTIA_SSR_URL=
INERTIA_SSR_ENABLED=true

RESPONSE_CACHE_ENABLED=false
RESPONSE_CACHE_DRIVER=file
RESPONSE_CACHE_LIFETIME=604800
RESPONSE_CACHE_WARM_BATCH_SIZE=50
RESPONSE_CACHE_WARM_CONCURRENCY=20

STATAMIC_LICENSE_KEY=
STATAMIC_STACHE_WATCHER=true
STATAMIC_REVISIONS_ENABLED=false
STATAMIC_GRAPHQL_ENABLED=false
STATAMIC_API_ENABLED=false
STATAMIC_GIT_ENABLED=false

LOG_CHANNEL=stack

# Workspace-local SQLite is sufficient for this Statamic-backed site.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_RESPONSE_CACHE_DB=2
# Optional separate Redis for the response cache, e.g. a unix socket path with port 0
# REDIS_RESPONSE_CACHE_HOST=/path/to/redis.sock
# REDIS_RESPONSE_CACHE_PORT=0

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

DEBUGBAR_ENABLED=false
