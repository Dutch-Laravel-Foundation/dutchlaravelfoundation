{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": ["artisan", "boost:mcp"],
            "env": {"APP_ENV": "local"}
        },
        "laravel-toolbar": {
            "command": "php",
            "args": ["artisan", "toolbar:mcp"],
            "env": {"APP_ENV": "local"}
        }
    }
}
